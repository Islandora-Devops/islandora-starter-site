diff --git a/modules/facets_exposed_filters/src/Plugin/views/filter/FacetsFilter.php b/modules/facets_exposed_filters/src/Plugin/views/filter/FacetsFilter.php
index bc0a876..1129bf3 100644
--- a/modules/facets_exposed_filters/src/Plugin/views/filter/FacetsFilter.php
+++ b/modules/facets_exposed_filters/src/Plugin/views/filter/FacetsFilter.php
@@ -404,7 +404,29 @@ class FacetsFilter extends FilterPluginBase implements ContainerFactoryPluginInt
   public function acceptExposedInput($input) {
     // Modules like views_dependent_filters alter the exposed option to ignore
     // the filter when hidden. We need to check for this.
-    return $this->isExposed();
+    if (!$this->isExposed()) {
+      return FALSE;
+    }
+
+    // Keep the exposed handler active even if this request only changed a
+    // different facet, the sort, or the pager. Views skips query() when an
+    // exposed handler rejects the input, but every facet still contributes its
+    // own query and result buckets.
+    $identifier = $this->options['expose']['identifier'];
+    if (!isset($input[$identifier]) || $input[$identifier] === 'All') {
+      $this->value = [];
+      return TRUE;
+    }
+
+    $value = $input[$identifier];
+    if (is_array($value) && $this->hasExposedRangeKeys($value)) {
+      $this->value = $this->getExposedRangeValues($value);
+    }
+    else {
+      $this->value = is_array($value) ? array_values($value) : [$value];
+    }
+
+    return TRUE;
   }
 
